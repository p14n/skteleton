package build

import mill._
import mill.kotlinlib._

trait CommonKotlinModule extends KotlinModule {
  def kotlinVersion = "2.0.21"

  object test extends KotlinTests with TestModule.Junit5 {
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.jetbrains.kotlin:kotlin-test-junit5:${this.kotlinVersion()}",
      mvn"org.junit.jupiter:junit-jupiter:5.10.3"
    )
  }
}

object components extends Module {

  object `event-protocol` extends CommonKotlinModule

  object `event-system` extends CommonKotlinModule {
    def moduleDeps = Seq(components.`event-protocol`)
  }
}

